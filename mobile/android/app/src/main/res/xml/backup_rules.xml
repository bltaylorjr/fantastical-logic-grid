<?xml version="1.0" encoding="utf-8"?>
<!-- Back up saved puzzles and settings (the WebView's IndexedDB lives in app_webview). -->
<full-backup-content>
    <include domain="root" path="app_webview/" />
    <exclude domain="root" path="app_webview/Default/Cache/" />
    <exclude domain="root" path="app_webview/Default/Code Cache/" />
</full-backup-content>
