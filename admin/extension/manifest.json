{
  "manifest_version": 3,
  "key": "",
  "name": "The Logic Grid Passwords",
  "short_name": "Passwords",
  "version": "1.0.0",
  "description": "Log in buttons in The Logic Grid admin Passwords page open the site and fill in your username, password and 2-step code.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "The Logic Grid Passwords",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "externally_connectable": {
    "matches": [
      "https://flg-api.btay74.workers.dev/admin/*",
      "http://localhost/admin/*"
    ]
  }
}
