{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Fantastical Logic Grid",
  "version": "1.15.3",
  "identifier": "com.fantasticallogicgrid.app",
  "build": {
    "frontendDist": "../../dist/web"
  },
  "app": {
    "windows": [
      {
        "title": "The Logic Grid",
        "width": 1280,
        "height": 860,
        "minWidth": 360,
        "minHeight": 480,
        "center": true,
        "dragDropEnabled": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "copyright": "© 2026 Bobby Taylor. All rights reserved.",
    "licenseFile": "../../LICENSE",
    "targets": [
      "nsis"
    ],
    "publisher": "The Fantastical Logic Grid",
    "homepage": "https://thelogicgrid.com",
    "category": "PuzzleGame",
    "shortDescription": "Story logic grid puzzles where every case is a brand new story",
    "longDescription": "Story logic grid puzzles: pick a difficulty, theme and size, then solve with hints, save, print with an answer key, race friends and play the daily puzzle.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzQzQzNTc0N0QwQkFBMTcKUldRWHFndDlkRFhFWTRHWURra1huSzlXckpvU2cxNjlhODNBL0FockNjQ0hWVncxYmU3NzlPajUK",
      "endpoints": [
        "https://github.com/bltaylorjr/thelogicgrid/releases/latest/download/latest.json",
        "https://github.com/bltaylorjr/fantastical-logic-grid/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
