{
  "name": "fantastical-logic-grid-engine",
  "version": "1.0.0",
  "description": "The Fantastical Logic Grid: generates logic grid puzzles with storylines, clues, hints and answer keys.",
  "type": "module",
  "main": "src/index.js",
  "exports": "./src/index.js",
  "bin": { "logic-grid": "./cli.js" },
  "scripts": {
    "test": "node test/run-tests.js && node test/kernel-tests.js",
    "test:quick": "node test/run-tests.js --quick",
    "test:modes": "node test/mode-tests.js && node test/mode-off-check.js check",
    "test:doctor": "node test/doctor-tests.js",
    "test:crossword": "node test/cw-tests.js --quick",
    "health": "node health.js",
    "health:quick": "node health.js --quick",
    "generate": "node cli.js"
  },
  "engines": { "node": ">=18" },
  "license": "UNLICENSED"
}
