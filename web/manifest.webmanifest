{
  "name": "The Fantastical Logic Grid",
  "short_name": "Logic Grid",
  "description": "Story logic grid puzzles with hints, saves and printable answer keys.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#F3F4F6",
