{
  "ci": {
    "collect": {
      "staticDistDir": "dist/site",
      "url": [
        "http://localhost/",
        "http://localhost/how-to-play/",
        "http://localhost/daily/",
        "http://localhost/themes/",
        "http://localhost/themes/mystery/",
        "http://localhost/difficulty-levels/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "total-blocking-time": [
          "warn",
          {
            "maxNumericValue": 300
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 1000000
          }
        ],
        "resource-summary:total:size": [
          "warn",
          {
            "maxNumericValue": 1048576
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
